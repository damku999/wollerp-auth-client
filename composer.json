{
    "name": "wollerp/auth-client",
    "description": "Validates RS256 access tokens issued by the Wollerp auth server. Product backends install this; it never issues tokens.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "wollerp",
        "auth",
        "jwt",
        "rs256",
        "laravel"
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "symfony/console": "^7.0|^8.0",
        "symfony/http-foundation": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "phpunit/phpunit": "^12.5|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Wollerp\\AuthClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wollerp\\AuthClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wollerp\\AuthClient\\WollerpAuthServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test:conformance": "pest --testsuite=conformance"
    },
    "scripts-descriptions": {
        "test": "Run the whole suite.",
        "test:conformance": "Run the package's own conformance tests. Inside a CONSUMER, run `php artisan wollerp:conformance --strict` instead — a dependency's autoload-dev is never loaded, so these test files are not on a product's autoloader."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
