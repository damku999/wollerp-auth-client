    }

    /**
     * Laravel resolves the migrations LEDGER from this, not from the
     * Schema::connection() used below. Without the override the tables are
     * created on the configured connection while the `migrations` row is
     * written to the DEFAULT one — so on a multi-database consumer (Coms
