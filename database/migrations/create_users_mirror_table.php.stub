     * The guard matters because a driver with no `modifyVirtualAs` — SQL Server
     * — does not error on `virtualAs()`, it silently ignores it. That would
     * create a plain NOT NULL `id` column with no default and no value, and the
     * first mirror write would fail. Skipping is the honest failure: `id` is
     * absent, and the product sees it immediately.
     */
    private const GENERATED_COLUMN_DRIVERS = ['mysql', 'mariadb', 'sqlite'];

    public function up(): void
    {
        $this->schema()->create($this->table(), function (Blueprint $table): void {
            $table->unsignedInteger('auth_user_id')->primary();   // token `uid`
            $this->addIdAlias($table);
            $table->char('auth_user_uuid', 26)->unique();         // token `sub`
            $table->string('name')->nullable();
            $table->string('email')->nullable();
            $table->string('status', 32)->nullable();
            $table->timestamp('email_verified_at')->nullable();
            $table->unsignedInteger('version')->default(0);       // token `ver`
            $table->timestamp('synced_at')->nullable();

            $table->index('email');
            $table->index('version');
        });
